rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════

    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.superAdmin == true;
    }

    // True if the caller is the authenticated owner of the property a
    // document references (used by offers below, so an agent can read
    // opinions/interest submitted on their own listings). Guarded with
    // exists() first: an offer can outlive its property (e.g. the agent
    // later deletes the listing), and calling get() on a missing document
    // would otherwise throw and deny the whole rule rather than just this
    // branch.
    function isOwnerOfProperty(propertyId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) &&
        get(/databases/$(database)/documents/properties/$(propertyId)).data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════
    // USERS
    // Public read: listings page fetches agent profiles (name,
    //   avatar, company) for property cards without auth.
    // Write: own document only.
    //
    // SECURITY: this document is read by ANYONE, with no auth and no
    // field-level restriction — Firestore rules cannot hide individual
    // fields on an otherwise-readable document. The since-removed SMS
    // Shortcuts feature briefly stored each enrolled agent's personal
    // mobile number here (`smsPhone`/`smsEnabled`, written server-side
    // via the Admin SDK, which bypasses the update allowlist below) —
    // a real, live PII exposure the moment anyone enabled it, entirely
    // independent of whether the app's own UI ever rendered it. Never
    // add a phone number, or any other field not meant for public
    // consumption, directly onto this document again. If a feature
    // needs to store something sensitive per-agent, give it its own
    // locked-down document instead (see `integrationCredentials` below
    // for the existing pattern) — never merge it into `users`/`agents`.
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if true;
      // superAdmin must never be settable by the account itself — it's
      // the one field isSuperAdmin() and verifyAdmin() (middleware/auth.js)
      // both trust completely, with no secondary check. Without this,
      // any signed-in user could self-promote at signup by including
      // superAdmin: true in their own initial account-creation write.
      //
      // SECURITY: every other server-only field (agencyBrandId,
      // brandColors, officeId, isOfficeAdmin, accountStatus, invitedAt,
      // activatedAt, invitedBy) must be excluded here too, not just on
      // `update` below — `create` had NO allowlist at all until this
      // fix, so a self-signup client write could set any of these on
      // its OWN initial account-creation call (e.g. self-assigning an
      // officeId/agencyBrandId it was never invited into). None of the
      // three legitimate signup/join/kiosk flows ever set any of these
      // at creation (confirmed by reading signup/page.js, join/page.js,
      // tv/[id]/page.js) — officeId/accountStatus/etc. are only ever
      // written by the Admin SDK (which bypasses these rules entirely),
      // via /api/offices and /api/branding/confirm.
      allow create: if isUser(userId)
        && !request.resource.data.keys().hasAny([
             'superAdmin', 'agencyBrandId', 'brandColors',
             'officeId', 'isOfficeAdmin', 'accountStatus',
             'invitedAt', 'activatedAt', 'invitedBy'
           ]);
      // Allowlist, not a denylist: only fields an agent/buyer's own
      // dashboard or settings page actually writes to their own account
      // (confirmed by reading every client-side updateDoc(doc(db,'users',...))
      // call site in the app — dashboard/settings, dashboard home, and the
      // SMS-verification flow). Everything else — superAdmin, pro,
      // agencyBrandId, brandColors, isAgent/isBuyer, and any privileged
      // field added in the future — is denied by default, rather than
      // relying on anyone remembering to add it to a denylist.
      // `logoUrl` IS client-writable directly (Account Settings' own
      // upload flow) and, under the shared-default + personal-override
      // branding model, that same field doubles as an agent's personal
      // logo override — no server route needed for logo-only changes.
      // `brandColors` (the colour half of that same override) is NOT
      // client-writable — it must only ever be set via
      // /api/branding/confirm (setPersonalBrandOverride), since colour
      // validation/contrast (buildColorSet) has to happen server-side.
      // agencyBrandId's own exclusion
      // (see the original comment this replaced) is preserved by simply
      // never appearing in this list: it must only ever be set by the
      // server (see /api/branding/confirm, Admin SDK) after validating the
      // requester actually owns/created that brand — never client-writable,
      // or an agent could self-assign someone else's brand (e.g. a
      // competing agency's colours/logo) directly.
      // `officeId`/`isOfficeAdmin`/`accountStatus`/`invitedAt`/
      // `activatedAt`/`invitedBy` are likewise never in this list —
      // office membership must only ever be set by the server (Admin
      // SDK, via /api/offices and /api/office-invites) after a genuine
      // invite was accepted or an office was created through the
      // validated signup path. Without this, an agent could write
      // officeId: '<any-office-id>' directly onto their own account and
      // instantly inherit that office's branding — or worse, an office
      // admin could add themselves to officeAdminUids on a DIFFERENT
      // office's doc, except that field lives on `offices/{officeId}`
      // (write: false, see below), never on this document at all.
      allow update: if isUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName', 'lastName', 'roles', 'avatar', 'logoUrl', 'companyName', 'phone', 'mobileConfirmedAt']);
      allow delete: if false;

      match /adminNotes/{noteId} {
        allow read, write: if isSuperAdmin();
      }

      match /purchases/{purchaseId} {
        allow read: if isUser(userId);
        allow write: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // PROPERTIES
    // Public read: anyone can browse listings.
    // Write: authenticated owner only (userId field must match).
    // ═══════════════════════════════════════════════════════════
    match /properties/{propertyId} {
      allow read: if true;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════
    // OFFERS (Price Opinions)
    // Anonymous create: web visitors submit price opinions
    //   without logging in - this is the core data collection.
    // Read: NOT public (buyer PII — name/email/phone — lives on these
    //   documents once someone registers interest). Restricted to the
    //   buyer who owns the offer (userId match), the agent who owns the
    //   referenced property, or a superAdmin. The old anonymous
    //   session-based "read back my previous opinion" lookup used by the
    //   property page now goes through /api/offers/session-lookup
    //   (Admin SDK, returns only the amount — never PII) instead of a
    //   direct client read, since that pattern can't be safely expressed
    //   as a security rule (see docs/security-finding-offers-public-read-pii.md).
    // Update: propertyId cannot change; if userId is being set
    //   the authenticated user must match.
    // ═══════════════════════════════════════════════════════════
    match /offers/{offerId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid
        || isOwnerOfProperty(resource.data.propertyId)
        || isSuperAdmin()
      );

      allow create: if request.resource.data.propertyId is string;

      allow update: if request.resource.data.propertyId == resource.data.propertyId
        && (
          !request.resource.data.keys().hasAll(['userId'])
          || (isAuth() && request.resource.data.userId == request.auth.uid)
        );

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // LIKES
    // Public read: like counts shown on property pages.
    // Create/delete: authenticated, own likes only.
    // Flutter doc ID pattern: {userId}_{propertyId}
    // ═══════════════════════════════════════════════════════════
    match /likes/{likeId} {
      allow read: if true;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.propertyId is string;

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // WATCHED AREAS (Buyer dashboard)
    // Suburbs/cities a buyer is tracking for PHI insights & alerts.
    // Read/write: own docs only (userId match). Server-side writes
    //   go through /api/buyer/watched-areas using the Admin SDK; this
    //   rule unlocks optimistic client updates later.
    // ═══════════════════════════════════════════════════════════
    match /watchedAreas/{docId} {
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════
    // AGENTS (Sub-profiles / team members)
    // Public read: property pages + listings display assigned
    //   agent name/avatar.
    //
    // SECURITY: same exposure as `users` above, and worse here — this
    // collection's `update` rule has no field allowlist at all, so the
    // owning account can write ANY field to their own sub-profile doc.
    // The since-removed SMS Shortcuts feature used this to store a
    // team member's personal mobile number (`smsPhone`/`smsEnabled`)
    // directly on this publicly-readable document via the CLIENT SDK
    // (AgentModal.js) — a real PII leak, readable by anyone with the
    // Firebase JS SDK, independent of this app's own UI. Never store a
    // phone number or other sensitive field here again; give it its
    // own locked-down document if a future feature genuinely needs one
    // (see `integrationCredentials` below for the existing pattern).
    // Write: own agents only (userId match).
    // ═══════════════════════════════════════════════════════════
    match /agents/{agentId} {
      allow read: if true;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════
    // DRAFT PROPERTIES
    // Full CRUD for own drafts only (userId match).
    // Created via setDoc with same ID as property.
    // ═══════════════════════════════════════════════════════════
    match /draftProperties/{draftId} {
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════
    // IMAGE EDITS
    // Read/update/delete: own edits only (userId match).
    // Create: authenticated (server also creates via Admin SDK).
    // Web uses onSnapshot filtered by userId + listingId.
    // ═══════════════════════════════════════════════════════════
    match /image_edits/{editId} {
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuth();

      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════
    // NOTIFICATIONS
    // Read/update: own notifications only (userId match) or superAdmin.
    // Create: authenticated (server creates for property events).
    // ═══════════════════════════════════════════════════════════
    match /notifications/{notifId} {
      allow read: if isAuth()
        && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuth();
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // DISPLAYS (TV / retail screens)
    // Public read: TV display pages load config by ID.
    // Write: superAdmin only.
    // ═══════════════════════════════════════════════════════════
    match /displays/{displayId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // CAMPAIGNS
    // Public read: homepage loads latest campaign.
    // Write: server-managed only.
    // ═══════════════════════════════════════════════════════════
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // AGENCY BRANDS
    // Public read: the public property page reads an agent's linked
    //   brand (logo + colours) without requiring the buyer to be logged
    //   in — same reasoning as public reads on `users`/`properties`.
    // Write: server-managed only (see /api/branding/confirm). Contains
    //   no secrets — logo URL and colour hex values only. Third-party
    //   integration credentials live separately in
    //   `integrationCredentials` and must never be merged into this.
    // ═══════════════════════════════════════════════════════════
    match /agencyBrands/{brandId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // OFFICES
    // Public read, but holds ONLY `agencyBrandId` — deliberately split
    //   from everything administrative/operational (see
    //   officeAdminInfo below). The public property page resolves an
    //   office member's branding by reading THIS doc's agencyBrandId
    //   (see PropertyPageClient.js), with no auth, exactly like it
    //   already reads an independent agent's own agencyBrandId — that
    //   is the ONLY reason this collection is public-read at all, and
    //   the ONLY field on it. Everything else that used to live here
    //   (name, officeAdminUids, status, createdBy, timestamps) was
    //   moved to officeAdminInfo specifically because none of it has
    //   any legitimate public-read use case, and officeAdminUids in
    //   particular would otherwise let anyone cross-reference it
    //   against the also-public `users` doc to learn exactly which
    //   agent administers a given office.
    // Write: server-managed only (see /api/offices, Admin SDK).
    // ═══════════════════════════════════════════════════════════
    match /offices/{officeId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // OFFICE ADMIN INFO
    // Server-only. Holds an office's name, officeAdminUids, status,
    //   createdBy and timestamps — the administrative/operational half
    //   split out of `offices` above specifically so none of it is
    //   publicly readable. The roster (agent names/emails/invite
    //   status) is NEVER stored here either — it only ever exists on
    //   `users` docs (officeId-filtered) and `officeInvites`, served
    //   exclusively through the authorized
    //   /api/offices/{officeId}/agents route, never a raw client read.
    //   An office admin must never be able to add themselves to
    //   another office's officeAdminUids, or point their own office's
    //   agencyBrandId at a brand they don't control — this doc's
    //   write:false, same as officeImports/officeInvites below, makes
    //   that structurally impossible rather than relying on a rule
    //   that has to get every field's write-condition exactly right.
    // ═══════════════════════════════════════════════════════════
    match /officeAdminInfo/{officeId} { allow read, write: if false; }

    // ═══════════════════════════════════════════════════════════
    // OFFICE IMPORTS (CSV bulk-onboarding batches)
    // Server-only, exactly like `docLinks`/`billingContacts` below —
    //   every row includes the CSV-submitted phone number, which must
    //   never be client-readable (see officeAgentContacts for the
    //   same reasoning on the durable per-agent copy). All access goes
    //   through /api/offices/{officeId}/import/* (Admin SDK), which
    //   does its own officeId-scoped authorization check per request —
    //   this rule intentionally grants the client nothing at all.
    // ═══════════════════════════════════════════════════════════
    match /officeImports/{importId} { allow read, write: if false; }

    // Hashed activation tokens for office-invited agents (server-only).
    match /officeActivations/{tokenHash} { allow read, write: if false; }

    // ═══════════════════════════════════════════════════════════
    // OFFICE AGENT CONTACTS (protected phone-number storage)
    // Server-only. The CSV-submitted phone number for an office-
    //   imported agent is deliberately NEVER written onto the
    //   publicly-readable `users/{uid}.phone` field — seeded here
    //   instead, in its own locked-down document, same pattern as
    //   `integrationCredentials` below. An agent who later enters their
    //   own phone number via Account Settings writes to the public
    //   `users.phone` field themselves (existing, unrelated, self-
    //   service behaviour) — that remains a deliberate choice they make
    //   about their own data, not something this import ever does for
    //   them.
    // ═══════════════════════════════════════════════════════════
    match /officeAgentContacts/{uid} { allow read, write: if false; }

    // ═══════════════════════════════════════════════════════════
    // OFFICE INVITES (existing-account "join this office" confirmations)
    // Server-only. An existing Premarket agent who's CSV-imported or
    //   individually added into an office is never silently linked —
    //   see officeImportService.js — they must click their own emailed
    //   link and explicitly accept (POST /api/office-invites/{token}),
    //   which is the only path that ever sets officeId for this case.
    //   No client read: the accept page fetches invite details through
    //   the authorized GET /api/office-invites/{token} route instead,
    //   which can safely return just the office name, not this
    //   document's other fields.
    // ═══════════════════════════════════════════════════════════
    match /officeInvites/{inviteId} { allow read, write: if false; }

    // ═══════════════════════════════════════════════════════════
    // OFFICE JOIN REQUESTS
    // Server-only. Filed automatically when someone tries to register
    //   a NEW office whose name exactly matches one that already
    //   exists (see officeService.js's createOffice) — this never
    //   silently creates a duplicate office or grants membership;
    //   it's a record for that existing office's own admins (or
    //   Premarket) to action manually. The person who triggered this
    //   still ends up with a completely normal, working individual
    //   agent account in the meantime — never a broken or dangling one.
    // ═══════════════════════════════════════════════════════════
    match /officeJoinRequests/{requestId} { allow read, write: if false; }

    // Server-only: records an agent's removal from an office so billing can
    // hold their later campaigns for review (see billingService.js).
    match /officeMembershipHistory/{uid} { allow read, write: if false; }

    // ═══════════════════════════════════════════════════════════
    // SETTINGS (App configuration)
    // Public read: Flutter reads agentPlans, introSlides,
    //   vendorPlans, phiWeights from client.
    // Write: server-managed via Admin SDK.
    //
    // Two doc IDs are denylisted from that public read:
    //   - xeroTokens: live Xero OAuth access/refresh tokens. A public
    //     read here would hand anyone on the internet a credential
    //     with full accounting-API access to whichever Xero org is
    //     connected.
    //   - invoicing: wholesale pricing (pricePerListing), GST rate,
    //     cron config, and the agent-exclusion list — internal billing
    //     configuration with no legitimate public-read use case.
    // Every other settings doc (phiWeights, agentSignup, etc.) keeps
    // the same public read it already had — this only removes read
    // access from these two specific IDs, nothing else changes.
    // ═══════════════════════════════════════════════════════════
    match /settings/{settingId} {
      allow read: if settingId != 'xeroTokens' && settingId != 'invoicing';
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // CONTACTS (CRM aggregated data)
    // Read: superAdmin only (CRM dashboard).
    // Write: server-only (nightly cron compute-contacts).
    // ═══════════════════════════════════════════════════════════
    match /contacts/{contactId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // PROPERTY ENGAGEMENT (Flutter tracking)
    // Read/create/update: authenticated users.
    // Web engagement goes through API route (server-side).
    // ═══════════════════════════════════════════════════════════
    match /propertyEngagement/{engagementId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // XP NOTIFICATIONS (Flutter gamification)
    // Read: authenticated (Flutter streams).
    // Write: server-managed.
    // ═══════════════════════════════════════════════════════════
    match /xpNotifications/{notifId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // IN-APP PURCHASES
    // Read/create: own purchases only (userId match).
    // No update/delete from client.
    // ═══════════════════════════════════════════════════════════
    match /inAppPurchases/{purchaseId} {
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // PRICE OPINIONS (Legacy Flutter collection)
    // Read/create: authenticated users.
    // ═══════════════════════════════════════════════════════════
    match /priceOpinions/{opinionId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && request.resource.data.propertyId is string;

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // PROPERTY STATS (Denormalized, server-computed)
    // Read: authenticated (Flutter streams).
    // Write: server-only.
    // ═══════════════════════════════════════════════════════════
    match /propertyStats/{propertyId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // STRIPE TRANSACTIONS
    // Read: own transactions only (userId match) or superAdmin.
    // Write: server-managed.
    // ═══════════════════════════════════════════════════════════
    match /stripeTransactions/{transId} {
      allow read: if isAuth()
        && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // SERVER-ONLY COLLECTIONS
    // All access exclusively via Admin SDK (API routes, crons,
    // Firebase Functions). No client access permitted.
    // ═══════════════════════════════════════════════════════════
    match /marketScores/{docId} { allow read, write: if false; }
    match /marketTrends/{docId} { allow read, write: if false; }
    match /propertyScores/{docId} { allow read, write: if false; }
    match /propertyViews/{docId} { allow read, write: if false; }
    match /propertyViewSessions/{docId} { allow read, write: if false; }
    match /agentboxContacts/{docId} { allow read, write: if false; }
    match /rexContacts/{docId} { allow read, write: if false; }
    match /coreProperties/{docId} { allow read, write: if false; }
    match /invoiceRuns/{docId} { allow read, write: if false; }
    match /invoiceRunItems/{docId} { allow read, write: if false; }
    match /propertyCharges/{docId} { allow read, write: if false; }
    match /billingAgencyOverrides/{docId} { allow read, write: if false; }
    match /billingContacts/{docId} { allow read, write: if false; }
    match /docLinks/{docId} { allow read, write: if false; }
    match /docSessions/{docId} { allow read, write: if false; }
    match /phiVerifications/{docId} { allow read, write: if false; }
    // Third-party integration credentials (Rex, Agentbox client IDs/API
    // keys/secrets). Deliberately kept out of the `users` document, which
    // is publicly readable — see docs/SECURITY.md.
    match /integrationCredentials/{userId} { allow read, write: if false; }

    // ═══════════════════════════════════════════════════════════
    // DEFAULT DENY
    // Any collection not explicitly listed above is denied.
    // This is Firestore's default behaviour but stated for clarity.
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
